<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>StockFlow Dashboard</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <header>
        <h1>StockFlow</h1>
        <p>Inventory & Product Operations</p>
    </header>

<main class="dashboard">

    <div class="dashboard-header">
        <div>
            <h2>Products</h2>
            <p>Manage and monitor your inventory.</p>
        </div>

        <a href="/products/add" class="add-product-btn">
            Add Product
        </a>
    </div>

    <div class="table-container">

        <table class="products-table">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Reorder Level</th>
                    <th>Status</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody id="products-container">
                <tr>
                    <td colspan="7">Loading products...</td>
                </tr>
            </tbody>

        </table>

    </div>

</main>

    <script src="/dashboard.js"></script>

</body>
</html>